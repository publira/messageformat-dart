{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>publira/.github//renovate.json5"],
  packageRules: [
    // The lower bound is the minimum SDK for consumers; it moves by hand
    // together with the lowest SDK in CI.
    {
      description: "Do not raise the minimum Dart SDK of the packages.",
      matchManagers: ["pub"],
      matchDepNames: ["dart"],
      enabled: false,
    },
    // `replace` turns `>=5.1.1 <7.0.0` into `<8.0.0`, and `widen` turns a
    // caret range into `^1.0.0 || ^2.0.0`, which pub rejects.
    {
      description: "Widen `>=x <y` pub constraints instead of replacing them.",
      matchManagers: ["pub"],
      matchCurrentValue: "/^>=\\S+ <\\S+$/",
      rangeStrategy: "widen",
    },
  ],
}
